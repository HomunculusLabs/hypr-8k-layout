# Recorded gesture traces are personal input data, never committed.
shape-corpus/
# Per-workspace swap memory is runtime state.
state/centerstage-swap-last-*
# Runtime locks and volatile handler/gamepad state.
*.lock
state/gamepad-connected
state/gamepad-mode
__pycache__/
# Time-stamped local backups of config files; git history is the backup.
*.bak.*
*.before-*
backups/
# Shaders are symlinks into the installed aether pack, not repo content.
shaders/
# Volatile: rewritten by running layout scripts.
state/centerstage-center-width
